# Nexora local environment overrides
NEXORA_APP_NAME=Nexora
NEXORA_ENVIRONMENT=local
NEXORA_LOCAL_FIRST=true
NEXORA_DEBUG=true

# Local service ports
NEXORA_BACKEND_HOST=127.0.0.1
NEXORA_BACKEND_PORT=8000
NEXORA_FRONTEND_PORT=8501

# Logging
NEXORA_LOG_LEVEL=INFO
NEXORA_LOG_TO_FILE=true

# Local Ollama runtime
NEXORA_OLLAMA_BASE_URL=http://localhost:11434
NEXORA_BACKEND_URL=http://127.0.0.1:8000
